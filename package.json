{
  "name": "@uniweb/projections",
  "version": "1.2.2",
  "description": "Projections of a Uniweb site's content — agent index, per-page markdown, search index, sitemap, robots.txt. Pure JS, runs anywhere.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./markdown-urls": "./src/markdown-urls.js",
    "./search": "./src/search/index.js",
    "./search/engine": "./src/search/engine.js",
    "./search/result": "./src/search/result.js",
    "./search/snippet": "./src/search/snippet.js"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "uniweb",
    "projections",
    "llms-txt",
    "markdown",
    "search"
  ],
  "author": "Proximify",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniweb/projections.git"
  },
  "homepage": "https://github.com/uniweb/projections#readme",
  "bugs": {
    "url": "https://github.com/uniweb/projections/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@uniweb/content-writer": "workspace:~",
    "@uniweb/core": "workspace:~"
  },
  "devDependencies": {
    "@uniweb/content-reader": "workspace:*",
    "vitest": "^4.1.7"
  }
